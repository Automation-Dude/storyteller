{
  "name": "@storyteller-platform/mapping",
  "description": "A library for mapping character offsets between pre- and post-transformed strings.",
  "keywords": [
    "mapping",
    "text",
    "transformation",
    "strings"
  ],
  "version": "0.1.3",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Shane Friedman",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx -C @storyteller --test \"**/*.test.ts\"",
    "test:watch": "tsx -C @storyteller --test --watch \"**/*.test.ts\"",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@storyteller-platform/eslint": "workspace:*",
    "@storyteller-platform/tsup": "workspace:^",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
