{"level":30,"time":1782485291986,"pid":94089,"hostname":"macbookpro.home","msg":"Running migration: \"81_mp3_quality_to_cbr_bitrate\"\n"}
{"level":30,"time":1782485291986,"pid":94089,"hostname":"macbookpro.home","msg":"-- MP3 export now uses constant bitrate. Convert any stored libmp3lame `-q:a`\n-- quality value (0-9) to the nearest CBR `-b:a` bitrate (see LAME -V tiers).\nUPDATE settings\nSET\n  value = CASE value\n    WHEN '\"0\"' THEN '\"256k\"'\n    WHEN '\"1\"' THEN '\"224k\"'\n    WHEN '\"2\"' THEN '\"192k\"'\n    WHEN '\"3\"' THEN '\"160k\"'\n    WHEN '\"4\"' THEN '\"160k\"'\n    WHEN '\"5\"' THEN '\"128k\"'\n    WHEN '\"6\"' THEN '\"112k\"'\n    WHEN '\"7\"' THEN '\"96k\"'\n    WHEN '\"8\"' THEN '\"80k\"'\n    WHEN '\"9\"' THEN '\"64k\"'\n    ELSE value\n  END\nWHERE\n  name = 'bitrate'\n  AND (\n    SELECT\n      value\n    FROM\n      settings\n    WHERE\n      name = 'codec'\n  ) = '\"libmp3lame\"';\n"}
{"level":30,"time":1782485291986,"pid":94089,"hostname":"macbookpro.home","msg":"e15f62eaefa552144098ea8b64290d5e9b666daf076ba4610ad23419051b2bab"}
{"level":30,"time":1782485291986,"pid":94089,"hostname":"macbookpro.home","msg":"Running migration: \"82_user_book_rating\"\n"}
{"level":30,"time":1782485291986,"pid":94089,"hostname":"macbookpro.home","msg":"CREATE TABLE IF NOT EXISTS user_book_rating (\n  uuid TEXT PRIMARY KEY NOT NULL DEFAULT (uuid ()),\n  user_id TEXT NOT NULL,\n  book_uuid TEXT NOT NULL,\n  rating REAL,\n  review TEXT,\n  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (user_id) REFERENCES user (id),\n  FOREIGN KEY (book_uuid) REFERENCES book (uuid),\n  UNIQUE (user_id, book_uuid),\n  CHECK (\n    rating IS NOT NULL\n    OR review IS NOT NULL\n  )\n);\n\nCREATE TRIGGER IF NOT EXISTS user_book_rating_update_trigger AFTER\nUPDATE ON user_book_rating FOR EACH ROW BEGIN\nUPDATE user_book_rating\nSET\n  updated_at = CURRENT_TIMESTAMP\nWHERE\n  uuid = OLD.uuid;\n\nEND;\n"}
