{"level":30,"time":1782481099225,"pid":77328,"hostname":"macbookpro.home","msg":"INSERT INTO\n  book_to_status (book_uuid, status_uuid, user_id)\nSELECT\n  book.uuid as book_uuid,\n  (\n    SELECT\n      uuid\n    FROM\n      status\n    WHERE\n      is_default = 1\n    LIMIT\n      1\n  ) as status_uuid,\n  user.id as user_id\nFROM\n  book\n  CROSS JOIN user\nWHERE\n  NOT EXISTS (\n    SELECT\n      1\n    FROM\n      book_to_status\n    WHERE\n      book_to_status.book_uuid = book.uuid\n      AND book_to_status.user_id = user.id\n  );\n"}
