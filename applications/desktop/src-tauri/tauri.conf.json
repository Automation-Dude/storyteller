{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyteller",
  "version": "2.14.13",
  "identifier": "dev.storyteller-platform.desktop",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://localhost:8001"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Storyteller",
        "url": "/",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/runtime.tar.gz", "resources/runtime-id"],
    "externalBin": [
      "binaries/node",
      "binaries/readium",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
